<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Your Name | UGC Creator</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700r:wght@300;400;500;600&display=swap

<style>
:root{
    --pink:#FFD6E8;
    --blue:#D8F3FF;
    --yellow:#FFF0B8;
    --cream:#FFFDF8;
    --text:#292929;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:var(--cream);
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
    color:var(--text);
}

.background-blob{
    position:fixed;
    border-radius:50%;
    filter:blur(100px);
    z-index:-1;
    opacity:.6;
}

.blob1{
    width:400px;
    height:400px;
    background:var(--pink);
    top:-100px;
    left:-100px;
}

.blob2{
    width:350px;
    height:350px;
    background:var(--blue);
    right:-100px;
    top:300px;
}

.blob3{
    width:300px;
    height:300px;
    background:var(--yellow);
    bottom:-100px;
    left:40%;
}

nav{
    display:flex;
    justify-content:space-between;
    padding:30px 8%;
    align-items:center;
}

.logo{
    font-family:'Playfair Display';
    font-size:1.5rem;
    font-weight:700;
}

.nav-links{
    display:flex;
    gap:30px;
}

.nav-links a{
    text-decoration:none;
    color:#333;
}

.hero{
    min-height:85vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:40px;
}

.hero-content{
    max-width:850px;
}

.hero h1{
    font-family:'Playfair Display';
    font-size:5rem;
    line-height:1;
    margin-bottom:20px;
}

.hero span{
    background:linear-gradient(90deg,#ff91c6,#8ad9ff,#ffd76f);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.hero p{
    font-size:1.2rem;
    line-height:1.8;
    color:#555;
    max-width:700px;
    margin:auto;
}

.buttons{
    margin-top:35px;
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    padding:15px 28px;
    border-radius:50px;
    border:none;
    cursor:pointer;
    font-size:1rem;
    text-decoration:none;
}

.primary{
    background:#111;
    color:white;
}

.secondary{
    background:white;
    color:#111;
}

section{
    padding:100px 10%;
}

.section-title{
    text-align:center;
    font-family:'Playfair Display';
    font-size:3rem;
    margin-bottom:60px;
}

.stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:25px;
}

.stat{
    background:white;
    padding:30px;
    border-radius:24px;
    text-align:center;
    box-shadow:0 10px 25px rgba(0,0,0,.05);
}

.stat h2{
    font-size:2.2rem;
}

.portfolio-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
}

.card{
    background:white;
    border-radius:28px;
    overflow:hidden;
    transition:.3s;
    box-shadow:0 10px 25px rgba(0,0,0,.06);
}

.card:hover{
    transform:translateY(-10px);
}

.card img{
    width:100%;
    height:350px;
    object-fit:cover;
}

.card-content{
    padding:20px;
}

.testimonial{
    background:white;
    border-radius:30px;
    padding:40px;
    max-width:800px;
    margin:auto;
    text-align:center;
    font-size:1.15rem;
    line-height:1.8;
}

.cta{
    text-align:center;
    background:linear-gradient(
        135deg,
        rgba(255,214,232,.7),
        rgba(216,243,255,.7),
        rgba(255,240,184,.7)
    );
    border-radius:40px;
    padding:80px 40px;
}

.cta h2{
    font-family:'Playfair Display';
    font-size:3rem;
    margin-bottom:20px;
}

footer{
    padding:40px;
    text-align:center;
    color:#666;
}

@media(max-width:768px){

.hero h1{
    font-size:3rem;
}

.section-title{
    font-size:2.2rem;
}

}
</style>
</head>

